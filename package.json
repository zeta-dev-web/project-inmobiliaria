    "setup-db": "node scripts/setup-db.js",
    "seed": "tsx prisma/seed.ts",
    "seed:list": "prisma db seed list",
    "studio": "prisma studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
